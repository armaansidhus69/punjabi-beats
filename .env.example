# Vercel dashboard → Project → Settings → Environment Variables
# Ye file sirf REFERENCE hai — values Apinator console (app page) se lo.
# NOTE: ye teeno SERVER-side hain — mobile/.env me KABHI mat daalo
# (mobile/.env me sirf EXPO_PUBLIC_* jate hain, wo public hote hain).

# App ID (console pe app banate waqt milta hai)
APINATOR_APP_ID=app_xxxxxxxxxxxxx

# Public app key (yahi value mobile/.env EXPO_PUBLIC_APINATOR_KEY me hoti hai)
APINATOR_KEY=apk_xxxxxxxxxxxxx

# Server secret — SIRF Vercel pe, client bundle me kabhi nahi
APINATOR_SECRET=xxxxxxxxxxxxxxxx

# Optional cluster (default eu) — EXPO_PUBLIC_APINATOR_CLUSTER se match rakho
APINATOR_CLUSTER=eu
