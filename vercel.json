{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-publish-token" }
      ]
    }
  ],
  "functions": {
    "api/publish.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/youtube-match.js": {
      "memory": 512,
      "maxDuration": 15
    },
    "api/share.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/ai-playlist.js": {
      "memory": 512,
      "maxDuration": 25
    },
    "api/ai-assistant.js": {
      "memory": 512,
      "maxDuration": 25
    }
  }
}
