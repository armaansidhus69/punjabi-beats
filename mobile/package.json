{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "cd .. && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test-logic.mjs && node test-loadqueue.mjs",
    "test:logic": "cd .. && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test-logic.mjs",
    "test:loadqueue": "cd .. && node test-loadqueue.mjs"
  },
  "dependencies": {
    "@apinator/client": "^2.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "axios": "^1.20.0",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-haptics": "~13.0.1",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-track-player": "^4.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.1",
    "typescript": "~5.3.3"
  },
  "private": true
}
