# Copy this file to .env and fill in real values.
# Apinator app key console (https://console.apinator.com) se milegi.
EXPO_PUBLIC_APINATOR_KEY=YAHAN_APNI_APP_KEY_DAALO
EXPO_PUBLIC_APINATOR_CLUSTER=eu
EXPO_PUBLIC_PUBLISH_URL=https://YOUR-VERCEL-APP.vercel.app/api/publish

# 🔒 /api/publish auth token. Ye EXACTLY Vercel ke PUBLISH_CLIENT_TOKEN se
# MATCH karna chahiye (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# NOTE: ye client bundle me visible rehti hai (EXPO_PUBLIC_) — obfuscation hai,
# real auth nahi. Iske bina room sync ke broadcasts 401 lekar fail honge.
EXPO_PUBLIC_PUBLISH_TOKEN=
# iTunes Search API (music source) — IN store best Punjabi results deta hai
EXPO_PUBLIC_ITUNES_COUNTRY=IN
# YouTube MATCH backend (root URL — app /api/youtube-match path khud jodta hai).
# Sirf videoId + metadata deta hai, direct audio URL nahi. YouTube Data API key
# ki zarurat NAHI (musicstream-sdk key-free hai).
EXPO_PUBLIC_YOUTUBE_MATCH_URL=https://YOUR-VERCEL-APP.vercel.app
# Jamendo (OPTIONAL, free/legal full songs) — https://devportal.jamendo.com/ se
# free key lo. Blank/placeholder chhodne par source skip ho jaata hai.
EXPO_PUBLIC_JAMENDO_KEY=
# OPTIONAL: koi JioSaavn mirror revive ho to URL daalo (abhi saare dead hain)
# EXPO_PUBLIC_JIOSAAVN_BASE=https://some-mirror.vercel.app
