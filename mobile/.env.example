# Copy this file to .env and fill in real values.
# Apinator app key console (https://console.apinator.com) se milegi.
EXPO_PUBLIC_APINATOR_KEY=YAHAN_APNI_APP_KEY_DAALO
EXPO_PUBLIC_APINATOR_CLUSTER=eu
EXPO_PUBLIC_PUBLISH_URL=https://YOUR-VERCEL-APP.vercel.app/api/publish

# 🔒 /api/publish auth token. Ye EXACTLY Vercel ke PUBLISH_CLIENT_TOKEN se
# MATCH karna chahiye (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# NOTE: ye client bundle me visible rehti hai (EXPO_PUBLIC_) — obfuscation hai,
# real auth nahi. Iske bina room sync ke broadcasts 401 lekar fail honge.
EXPO_PUBLIC_PUBLISH_TOKEN=
# Future authenticated/catalog API base. Leave blank during guest-only phases.
EXPO_PUBLIC_API_BASE_URL=

# Supabase public client configuration. Never put a service-role key here.
# EXPO_PUBLIC_SUPABASE_ANON_KEY is accepted as a legacy fallback.
EXPO_PUBLIC_SUPABASE_URL=https://xlprzushieqhlqrwafeq.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oC7svhH7WJrGVyF1ZjSECA_AY8cYnzN
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhscHJ6dXNoaWVxaGxxcndhZmVxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMwMDQ3NTYsImV4cCI6MjEwODU4MDc1Nn0.RP-CpDNKaN6SSRmeH7VJeSkXDVPqjOYR8QmwfNnAqXs
# Internal/beta opt-in. Keep false or blank for guest-only production builds.
EXPO_PUBLIC_AUTH_ENABLED=false
# Internal/beta opt-in for Phase 10 Blend — manual testing builds ke liye `true`.
EXPO_PUBLIC_BLEND_ENABLED=false
# Internal/beta opt-in for Phase 11 Jam + Listening Party — manual testing builds ke liye `true`.
EXPO_PUBLIC_JAM_ENABLED=false
# Internal/beta opt-in for Phase 12a Podcasts — local-only feature.
EXPO_PUBLIC_PODCASTS_ENABLED=false
# iTunes Search API (music source) — IN store best Punjabi results deta hai
EXPO_PUBLIC_ITUNES_COUNTRY=IN
# YouTube MATCH backend (root URL — app /api/youtube-match path khud jodta hai).
# Sirf videoId + metadata deta hai, direct audio URL nahi. YouTube Data API key
# ki zarurat NAHI (musicstream-sdk key-free hai).
EXPO_PUBLIC_YOUTUBE_MATCH_URL=https://YOUR-VERCEL-APP.vercel.app
# Optional Reverbio-style Piped audio bridge. Use a live Piped API instance;
# leave blank to keep YouTube bridge metadata-only and use Verome/iTunes fallback.
# EXPO_PUBLIC_PIPED_API=https://your-piped-api.example.com
# Verome (Deno Deploy) — YouTube Music search + stream provider. Blank/placeholder
# chhodne par feature skip ho jaata hai.
EXPO_PUBLIC_VEROME_API=https://YOUR-VEROME-API.deno.dev
# Jamendo (OPTIONAL, free/legal full songs) — https://devportal.jamendo.com/ se
# free key lo. Blank/placeholder chhodne par source skip ho jaata hai.
EXPO_PUBLIC_JAMENDO_KEY=
# Open-source JioSaavn API override (optional; default is https://saavn.sumit.co).
# Self-host the MIT-licensed API for production reliability if desired.
# EXPO_PUBLIC_JIOSAAVN_BASE=https://your-jiosaavn-api.example.com
